# ── Anthropic ──────────────────────────────────────────────
# Lấy tại https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
ANTHROPIC_MODEL=claude-sonnet-4-6
ANTHROPIC_MAX_TOKENS=2048

# ── Telegram ───────────────────────────────────────────────
# Tạo bot tại https://t.me/BotFather → /newbot
TELEGRAM_BOT_TOKEN=your_bot_token_here
# Secret token để xác thực webhook (tùy chọn nhưng nên có)
TELEGRAM_SECRET_TOKEN=your_random_secret_here

# ── Redis (conversation history) ───────────────────────────
# docker run -d -p 6379:6379 redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
